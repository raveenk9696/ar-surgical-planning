{
  "name": "ar-surgical-planning-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mark up one CT scan together: a 2026 rebuild of a 2022 lab app.",
  "scripts": {
    "dev": "node scripts/ensure-model.mjs && vite",
    "dev:https": "node scripts/ensure-model.mjs && VITE_HTTPS=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/ensure-model.mjs && vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "probe:relays": "node scripts/probe-relays.mjs",
    "model:pack": "node scripts/pack-model.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/homemade-apple": "5.3.0",
    "@trystero-p2p/nostr": "0.26.0",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "fast-check": "4.10.2",
    "gltfpack": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
